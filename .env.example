# Copie para .env e configure localmente. Não compartilhe tokens.
ML_ACCESS_TOKEN=
# Modo OAuth HTTPS (não requer ML_ACCESS_TOKEN estático)
SUPABASE_PROJECT_URL=
BOT_API_SECRET=
# Sessão cifrada do WhatsApp para jobs no GitHub Actions (32 bytes em base64)
WHATSAPP_SESSION_KEY=
# Alternativa opcional: ponte externa HTTPS
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=
